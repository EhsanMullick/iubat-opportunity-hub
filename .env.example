# ==============================================================================
# EVENTORA / IUBAT OPPORTUNITY HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Supabase credentials (get from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for canonical links, auth redirects, and social sharing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret token to protect the scheduled event expiration API endpoint (/api/cron/expire-events)
CRON_SECRET=your-secure-random-cron-secret

# Optional AI Gateway or Gemini API Key for intelligent career & opportunity recommendations
# (If not provided, the platform uses an intelligent deterministic skill-matching fallback engine)
AI_GATEWAY_API_KEY=
GEMINI_API_KEY=
